PORT=3101

# Supabase — used by POST /api/auth/verify-supabase (same project as the Flutter app).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Client -> this API (shared secret)
APP_ERP_TOKEN=replace_with_strong_token

# Frappe / ERPNext site URL (no trailing slash)
ERP_BASE_URL=https://your-site.example.com

# --- Frappe `mobile_app.api.v1.*` (users_lookup, users_full_sync, …) ---
# Must match sites/<site>/site_config.json → "mobile_app_erp_token".
# If you use a Desk API key in ERP_TOKEN for /api/resource/…, set the mobile token here:
MOBILE_APP_ERP_TOKEN=your_mobile_app_erp_token_same_as_site_config
#
# V1 calls send ONLY: X-ERP-Token + Authorization: Bearer (never Authorization: token … for V1).

# --- Frappe /api/resource/… (DocTypes) ---
# "token" = Authorization: token api_key:api_secret | "bearer" = Bearer …
ERP_AUTH_SCHEME=token
ERP_TOKEN=api_key:api_secret_or_same_as_mobile_if_one_secret

# DocTypes from mobile_app Frappe app (see erpmobileapp.md / filds.md)
DOCTYPE_MOBILE_APP_USER=Mobile App User
DOCTYPE_MOBILE_APP_USER_SESSION=Mobile App User Session
DOCTYPE_MOBILE_APP_USER_PROFILE=Mobile App User Profile
DOCTYPE_MOBILE_APP_DISEASE=Mobile App Disease
DOCTYPE_MOBILE_APP_USER_DISEASE_SELECTION=Mobile App User Disease Selection
DOCTYPE_MOBILE_APP_HEALTH_ENTRY=Mobile App Health Entry
DOCTYPE_MOBILE_APP_PRESCRIPTION=Mobile App Prescription
DOCTYPE_MOBILE_APP_DOCTOR=Mobile App Doctor
DOCTYPE_MOBILE_APP_APPOINTMENT=Mobile App Appointment
DOCTYPE_MOBILE_APP_NOTIFICATION=Mobile App Notification
DOCTYPE_MOBILE_APP_SUPPORT_TICKET=Mobile App Support Ticket
DOCTYPE_MOBILE_APP_WEBHOOK_EVENT=Mobile App Webhook Event
